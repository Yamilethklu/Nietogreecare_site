##############################################################################
# NIETO GREEN CARE LLC — Variables de entorno
# ---------------------------------------------------------------------------
# 1) Copie este archivo como `.env.local`
# 2) Rellene cada valor con las claves reales de cada proveedor
# 3) Reinicie el servidor de desarrollo (`npm run dev`)
#
#   PowerShell:  Copy-Item .env.local.example .env.local
#   Bash:        cp .env.local.example .env.local
##############################################################################

# ===========================================================================
# 1) SITIO / SEO
# ===========================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================================================
# 2) SUPABASE (Base de datos Postgres, Auth, Storage)
#    Dashboard > Project Settings > API
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemple_anon_key
# SOLO se usa en el servidor (nunca exponerla al navegador)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemple_service_role_key

# Buckets de Storage (creados por /supabase/storage.sql)
NEXT_PUBLIC_SUPABASE_GALLERY_BUCKET=gallery
NEXT_PUBLIC_SUPABASE_SNAPSHOT_BUCKET=lead-snapshots

# Correos autorizados para entrar al panel /admin (separados por coma)
ADMIN_ALLOWED_EMAILS=nietogreencare@gmail.com,yamilethklunder@gmail.com

# ===========================================================================
# 3) GOOGLE MAPS PLATFORM
#    APIs requeridas:
#      - Maps JavaScript API
#      - Places API (New)
#      - Geocoding API
#      - Maps Static API  (para el recorte satelital del área delimitada)
#      - Maps Elevation API (opcional)
# ===========================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyExempleGoogleMapsBrowserKey
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Clave restringida por IP para el endpoint /api/map/snapshot (recorte satelital)
GOOGLE_MAPS_SERVER_API_KEY=AIzaSyExempleGoogleMapsServerKey

# ===========================================================================
# 4) NOTIFICACIONES POR CORREO (Resend)
#    https://resend.com/api-keys
# ===========================================================================
RESEND_API_KEY=re_ExempleResendApiKey
EMAIL_FROM="Nieto Green Care <onboarding@resend.dev>"
EMAIL_TO=nietogreencare@gmail.com
EMAIL_REPLY_TO=nietogreencare@gmail.com

# --- Alternativa SMTP con Nodemailer (si prefiere no usar Resend) -----------
# Si SMTP_HOST + SMTP_USER + SMTP_PASS están definidos, se usa Nodemailer.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ===========================================================================
# 5) NOTIFICACIONES POR SMS (Twilio)  — EXCLUSIVAMENTE SMS, NO WhatsApp
#    https://console.twilio.com
# ===========================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15125550123
# Número del dueño que recibe las alertas de nuevos leads (formato E.164)
OWNER_SMS_NUMBER=+17373144215

# ===========================================================================
# 6) CONTACTO / OPERACIÓN
# ===========================================================================
NEXT_PUBLIC_BUSINESS_PHONE=7373144215
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY=737-314-4215
NEXT_PUBLIC_BUSINESS_EMAIL=nietogreencare@gmail.com

# ===========================================================================
# 7) PAGOS (sin procesamiento de tarjetas — Cash App / Zelle únicamente)
# ===========================================================================
NEXT_PUBLIC_CASHAPP_TAG=$JaimeNietoMorales
NEXT_PUBLIC_ZELLE_NAME=Nieto Green Care LLC
NEXT_PUBLIC_ZELLE_PHONE=737-314-4215

# ===========================================================================
# 8) COTIZADOR (reglas por defecto)
# ===========================================================================
NEXT_PUBLIC_DEFAULT_MOW_DEPTH_INCHES=2
NEXT_PUBLIC_SERVICE_ZIP_CODES=78701,78702,78703,78704,78705,78717,78724,78725,78726,78727,78728,78729,78730,78731,78732,78733,78734,78735,78736,78737,78738,78739,78741,78742,78744,78745,78746,78747,78748,78749,78750,78751,78752,78753,78754,78755,78756,78757,78758,78759,78634,78660,78664,78665,78681,78682,78683,78626,78628,78633,78613,78641,78642,78646